---
interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'photos' | 'contact';
  basePath?: string;
}

const {
  title = 'justin kinney',
  description = "Justin Kinney's personal blog and photo notes.",
  active = 'home',
  basePath = '/',
} = Astro.props;

const homeHref = `${basePath}`;
const photosHref = `${basePath}gallery/`;
const contactHref = '#contact';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="logo" href={homeHref} aria-label="Home">JK<span>_</span></a>

      <nav aria-label="Primary navigation">
        <ul class="nav-links">
          <li><a class:list={[{ active: active === 'home' }]} href={homeHref}>Home</a></li>
          <li><a class:list={[{ active: active === 'photos' }]} href={photosHref}>Photos</a></li>
          <li><a class:list={[{ active: active === 'contact' }]} href={contactHref}>Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer" id="contact">
    <div class="container footer-row">
      <ul class="footer-links">
        <li><a href="mailto:hello@justinkinney.com">hello@justinkinney.com</a></li>
        <li><a href="https://linkedin.com/in/justinkinney">LinkedIn</a></li>
        <li><a href="https://github.com/justinkinney">GitHub</a></li>
      </ul>
      <p>© 2026 Justin Kinney.</p>
    </div>
  </footer>
</body>
</html>
